{
  "openapi": "3.0.1",
  "info": {
	"title": "KS SvarUt: NHN API",
	"description": "proxy API for  NHN tjenester",
	"license": {
	  "name": "MIT",
	  "url": "https://opensource.org/licenses/MIT"
	},
	"contact": {
	  "name": "Fiks-brukerstøtte",
	  "url": "https://ks-no.github.io/",
	  "email": "fiks@ksdigital.no"
	},
	"version": "v1"
  },
  "servers": [
	{
	  "url": "https://test.svarut.ks.no/api",
	  "description": "SvarUt testmiljø"
	},
	{
	  "url": "https://svarut.ks.no/api",
	  "description": "SvarUt produksjonsmiljø"
	}
  ],
  "security": [
	{
	  "bearerAuth": []
	}
  ],
  "tags": [
	{
	  "name": "Nhn",
	  "description": "API for oppslag i NHN adresseregister"
	}
  ],
  "paths": {
	"/v1/nhn/oppslag/{kontoId}/{herId}": {
	  "get": {
		"tags": [
		  "Nhn"
		],
		"summary": "Hent adresseregisteroppføring for HerId på konto",
		"description": "Henter en communication party fra NHN adresseregister basert på et HER-id som kontoen er koblet til",
		"operationId": "adresseregisterOppslag",
		"parameters": [
		  {
			"name": "kontoId",
			"in": "path",
			"required": true,
			"description": "KontoId som må være koblet til HER-id-et som skal slås opp",
			"schema": {
			  "type": "string",
			  "format": "uuid"
			},
			"example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
		  },
		  {
			"name": "herId",
			"in": "path",
			"required": true,
			"description": "HER-id som skal slås opp i NHN adresseregister. Må være konfiguert på kontoen.",
			"schema": {
			  "type": "integer",
			  "format": "int32",
			  "minimum": 1
			},
			"example": 12345
		  }
		],
		"responses": {
		  "200": {
			"description": "Communication party funnet for oppgitt HerId på kontoen",
			"content": {
			  "application/json": {
				"schema": {
				  "$ref": "#/components/schemas/CommunicationParty"
				}
			  }
			}
		  },
		  "403": {
			"description": "Kontoen har ikke konfiguert HER-id eller har ikke tilgang til oppgitt HerId",
			"content": {
			  "application/json": {
				"schema": {
				  "$ref": "#/components/schemas/ErrorMessage"
				}
			  }
			}
		  },
		  "404": {
			"description": "Communication party finnes ikke for oppgitt HerId",
			"content": {
			  "application/json": {
				"schema": {
				  "$ref": "#/components/schemas/ErrorMessage"
				}
			  }
			}
		  },
		  "default": {
			"description": "Feil",
			"content": {
			  "application/json": {
				"schema": {
				  "$ref": "#/components/schemas/ErrorMessage"
				}
			  }
			}
		  }
		}
	  }
	}
  },
  "components": {
	"securitySchemes": {
	  "bearerAuth": {
		"type": "http",
		"scheme": "bearer",
		"bearerFormat": "JWT"
	  }
	},
	"schemas": {
	  "CommunicationParty": {
		"$ref": "../../fiks-nhn-specs/specs/adresseregister-v1.json#/components/schemas/CommunicationParty"
	  },
	  "ErrorMessage": {
		"type": "object",
		"properties": {
		  "timestamp": {
			"type": "integer",
			"format": "int64"
		  },
		  "status": {
			"type": "integer",
			"format": "int32"
		  },
		  "error": {
			"type": "string"
		  },
		  "errorId": {
			"type": "string",
			"format": "uuid"
		  },
		  "path": {
			"type": "string"
		  },
		  "originalPath": {
			"type": "string"
		  },
		  "message": {
			"type": "string"
		  },
		  "errorCode": {
			"type": "string"
		  },
		  "errorJson": {
			"type": "string"
		  }
		}
	  }
	}
  }
}
